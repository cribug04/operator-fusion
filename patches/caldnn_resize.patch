+    /// 整数倍上采样：x 是 NHWC 紧排的图 `[h, w, c]`（三维张量）⇒ y `[scale·h, scale·w, c]`。
+    ///
+    /// # Panics
+    /// x 不是三维时 panic（图的规格错误，不是运行时条件）。
+    pub fn resize(&mut self, x: Uid, scale: u32, mode: Interp) -> Uid {
+        let dims = &self[x].dims;
+        assert!(dims.len() == 3, "resize：x 要是 [h, w, c] 三维的图");
+        let (h, w, c) = (dims[0], dims[1], dims[2]);
+        let y = self.tmp(&[scale * h, scale * w, c]);
+        self.op(Op::Resize(ResizeDesc { h, w, c, scale, mode }, [x, y]));
+        y
+    }
+
+    /// 双线性 ×2（`align_corners = false`）：[`Self::resize`] 的常用特例。
+    pub fn upsample_bilinear2(&mut self, x: Uid) -> Uid {
+        self.resize(x, 2, Interp::Bilinear)
+    }
