@@ -0,0 +1,98 @@
+//! 题一：融合残差加法与 RMSNorm。融合 kernel 与「先加再归一」逐步同序（bf16 加、舍一次），数值应逐位相同，
+//! 融合将残差留在 vcache 中继续归一化，省去残差的一次 DDR 读回。
+//!
+//! - [`kernels`]：融合 kernel 的尺寸特化（两遍都编）
+//! - [`engines`]：融合引擎表（主机遍）
+//! - [`model`]：一层的图（主机遍）
+#![cfg_attr(not(test), no_std)]
+
+pub mod kernels;
+
+#[cfg(all(feature = "step", target_arch = "riscv32", target_os = "none"))]
+mod step;
+
+#[cfg(not(all(target_arch = "riscv32", target_os = "none")))]
+pub mod engines;
+#[cfg(not(all(target_arch = "riscv32", target_os = "none")))]
+pub mod model;
+
+#[cfg(test)]
+extern crate std;
+
+#[cfg(test)]
+mod tests {
+    use calblas::caldnn::{Arg, Elem, FirstFit, Graph, NormKind, Plan, Pw};
+    use std::vec;
+
+    use crate::{engines, model};
+
+    fn ptr(u: calblas::caldnn::Uid) -> Arg {
+        Arg::Ptr(u64::from(u.0))
+    }
+
+    /// 融合引擎认下相邻的 `Pointwise(Add)` 与 `Norm(Rms)`：一条作业、5 个指针，次序 a、b、w、残差、输出。
+    #[test]
+    fn fused_is_one_job() {
+        let (g, io) = model::graph();
+        let plan = Plan::new(&g, engines::FUSED, &FirstFit::default()).unwrap();
+        assert_eq!(plan.jobs().len(), 1, "融合后应只有一个作业");
+        let j = &plan.jobs()[0];
+        assert_eq!(j.kernel, "fused_add_rms_norm");
+        assert_eq!(j.args, std::vec![ptr(io.a), ptr(io.b), ptr(io.w), ptr(io.residual), ptr(io.y)]);
+    }
+
+    /// 不挂融合引擎时退回两个单算子：作业数 2，残差那个中间张量要多读一遍。
+    #[test]
+    fn split_is_two_jobs() {
+        let (g, _io) = model::graph();
+        let plan = Plan::new(&g, engines::SPLIT, &FirstFit::default()).unwrap();
+        let names: vec::Vec<&str> = plan.jobs().iter().map(|j| j.kernel).collect();
+        assert_eq!(names, ["residual_add", "hidden_rms_norm"]);
+    }
+
+    /// 形状（eps）对不上就不该融合——融合引擎必须拒绝，不能算错。
+    #[test]
+    fn eps_mismatch_not_accepted_by_fused() {
+        let mut g = Graph::default();
+        let n = model::ROWS * model::HIDDEN;
+        let a = g.input(Elem::Bf16, &[n]);
+        let b = g.input(Elem::Bf16, &[n]);
+        let w = g.input(Elem::Bf16, &[1, model::HIDDEN]);
+        let s = g.pointwise(Pw::Add, a, Some(b));
+        g.norm(NormKind::Rms, s, Some(w), None, model::ROWS, model::EPS + 1.0e-3);
+        let only_fused: &[&dyn calblas::caldnn::Engine] = &[&engines::FUSED_ENGINE];
+        assert!(
+            Plan::new(&g, only_fused, &FirstFit::default()).is_err(),
+            "特化表里没有这个 eps ⇒ 引擎拒绝，交给两步路径"
+        );
+    }
+
+    /// 归一化的输入不是那个残差张量（中间插了别的运算）时也不能融合。
+    #[test]
+    fn unrelated_norm_not_fused() {
+        let mut g = Graph::default();
+        let n = model::ROWS * model::HIDDEN;
+        let a = g.input(Elem::Bf16, &[n]);
+        let b = g.input(Elem::Bf16, &[n]);
+        let w = g.input(Elem::Bf16, &[1, model::HIDDEN]);
+        let s = g.pointwise(Pw::Add, a, Some(b));
+        g.norm(NormKind::Rms, a, Some(w), None, model::ROWS, model::EPS);
+        let plan = Plan::new(&g, engines::FUSED, &FirstFit::default()).unwrap();
+        assert_eq!(plan.jobs().len(), 2, "归一化吃的不是残差 ⇒ 不融合");
+        assert!(s.0 < u32::MAX);
+    }
+
+    #[test]
+    fn rejects_missing_or_wrong_sized_weight() {
+        let only_fused: &[&dyn calblas::caldnn::Engine] = &[&engines::FUSED_ENGINE];
+        for weight_len in [None, Some(model::HIDDEN - 1), Some(model::HIDDEN + 1)] {
+            let mut g = Graph::default();
+            let a = g.input(Elem::Bf16, &[model::ROWS, model::HIDDEN]);
+            let b = g.input(Elem::Bf16, &[model::ROWS, model::HIDDEN]);
+            let w = weight_len.map(|n| g.input(Elem::Bf16, &[n]));
+            let s = g.pointwise(Pw::Add, a, Some(b));
+            g.norm(NormKind::Rms, s, w, None, model::ROWS, model::EPS);
+            assert!(Plan::new(&g, only_fused, &FirstFit::default()).is_err());
+        }
+    }
+}
