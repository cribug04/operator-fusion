+//! 一层里的那两步：`s = a + b`（残差，后面还要用）⇒ `y = rms_norm(s) · w`。
+//! 图照真实模型的写法搭——先 `pointwise(Add)` 再 `norm(Rms)`，融合与否是这个图的两种编排。
+
+use calblas::caldnn::{Elem, Graph, NormKind, Pw, Uid};
+
+pub const ROWS: u32 = 4;
+pub const HIDDEN: u32 = 4096;
+pub const EPS: f32 = 1.0e-6;
+
+pub struct Io {
+    pub a: Uid,
+    pub b: Uid,
+    pub w: Uid,
+    pub residual: Uid,
+    pub y: Uid,
+}
+
+pub fn graph() -> (Graph, Io) {
+    let mut g = Graph::default();
+    let a = g.input(Elem::Bf16, &[ROWS, HIDDEN]);
+    let b = g.input(Elem::Bf16, &[ROWS, HIDDEN]);
+    let w = g.input(Elem::Bf16, &[1, HIDDEN]);
+    let residual = g.pointwise(Pw::Add, a, Some(b));
+    let y = g.norm(NormKind::Rms, residual, Some(w), None, ROWS, EPS);
+    let y = g.output(y);
+    (g, Io { a, b, w, residual, y })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// 两步的形状：逐元素包住 [rows, n]，归一化的 n 就是隐藏维。
+    #[test]
+    fn graph_shape() {
+        let (g, io) = graph();
+        assert_eq!(g.ops().len(), 2);
+        assert_eq!(g[io.residual].numel(), ROWS * HIDDEN);
+        assert_eq!(g[io.y].numel(), ROWS * HIDDEN);
+        assert!(!g[io.y].virt, "输出要标成输出（调用方给地址）");
+        assert!(g[io.residual].virt, "残差是中间张量");
+    }
+}
