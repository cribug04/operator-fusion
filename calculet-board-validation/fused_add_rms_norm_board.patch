+//! 本例子用到的特化：融合 kernel 一个，对照组的两步（`binary!(add)` 与 `rms_norm!`）各一个。
+//! 尺寸取 Qwen3-8B 那种「4 个 token × 4096 隐藏维」——`examples/qwen3_8b` 里已有 `rows = 4, n = 4096` 的 rms_norm。
+
+calblas::add_rms_norm!(pub fused_add_rms_norm: rows = 4, n = 4096, eps = 1.0e-6);
+calblas::binary!(pub residual_add: add, n = 4 * 4096);
+calblas::rms_norm!(pub hidden_rms_norm: rows = 4, n = 4096, eps = 1.0e-6);
