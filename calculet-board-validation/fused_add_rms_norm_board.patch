 //! 引擎：每种运算（与参数签名）一个，持有「形状描述 ⇒ kernel 桩」的表（表在 examples 里按模型给），按图里运算的描述查表出作业。
 //! 作业的指针参数先填张量号（`Uid` ⇒ `Ptr`），[`caldnn::Plan::bind`] 再换成地址。
 use caldnn::{
-    CompressDesc, ConvDesc, DeltanetDesc, HcDesc, LightningIndexDesc, SinkAttnDesc, EmbeddingDesc, Engine, Graph, HwptnDesc, MatmulDesc, MoeDenseDesc, MoeGatePostDesc, MoeGatePreDesc, MoeGluDesc, NormDesc, Notes, Op,
-    PwDesc, RopeDesc, ScatterKvDesc, SdpaDesc, SharedGatedAddDesc, SparseIndexDesc, SparseSdpaDesc, Step, TransferDesc,
+    CompressDesc, ConvDesc, DeltanetDesc, HcDesc, LightningIndexDesc, SinkAttnDesc, EmbeddingDesc, Engine, Graph, HwptnDesc, MatmulDesc, MoeDenseDesc, MoeGatePostDesc, MoeGatePreDesc, MoeGluDesc, NormDesc, NormKind, Notes, Op,
+    PwDesc, Pw, RopeDesc, ScatterKvDesc, SdpaDesc, SharedGatedAddDesc, SparseIndexDesc, SparseSdpaDesc, Step, TransferDesc, Uid,
 };
 use npu::{bf16, f8e4m3, u4, Ddr, Launch, Ptr, Ram};
 
@@ -130,3 +130,37 @@ engines! {
     /// `calblas::mat2_hwptn!` / `calblas::hwptn2_mat!`
     Hwptn(HwptnDesc, Hwptn, Notes::NONE) fn(Bf, Bf) = |io| (io[0], io[1]);
 }
+
+/// `calblas::add_rms_norm!` 认的形状（rows 行 × n 列，eps 进 kernel 的常数）。
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct FusedNormDesc {
+    pub rows: u32,
+    pub n: u32,
+    pub eps: f32,
+}
+
+/// 融合引擎：一条 [`Step`] 认下图里相邻的两个运算——`Pointwise(Add)`（残差）与 `Norm(Rms)`（归一化），出一个作业。
+/// 融合引擎要排在单算子引擎（`Binary` / `RmsNorm`）**前面**：`FirstFit` 按表里的次序取第一个认得的。
+pub struct AddRmsNorm<'a>(pub &'a [(FusedNormDesc, fn(Bf, Bf, Bf, Bf, Bf) -> Launch<(Bf, Bf, Bf, Bf, Bf)>)]);
+
+impl Engine for AddRmsNorm<'_> {
+    fn name(&self) -> &str {
+        "AddRmsNorm"
+    }
+    fn step(&self, g: &Graph, at: usize) -> Option<Step<'_>> {
+        let &Op::Pointwise(PwDesc { f: Pw::Add, n }, [a, b, res]) = g.ops().get(at)? else { return None };
+        let &Op::Norm(NormDesc { kind: NormKind::Rms, rows, n: hn, eps }, [x, w, bias, y]) = g.ops().get(at + 1)? else { return None };
+        // 归一化吃的正是残差那个中间张量，且不带偏置；rows · n 要等于逐元素的元素数
+        if x != res || b == Uid::NONE || w == Uid::NONE || bias != Uid::NONE || rows.checked_mul(hn)? != n {
+            return None;
+        }
+        if [a, b, res, y].into_iter().any(|u| g[u].elem != caldnn::Elem::Bf16 || g[u].numel() != n)
+            || g[w].elem != caldnn::Elem::Bf16 || g[w].numel() != hn
+        {
+            return None;
+        }
+        let desc = FusedNormDesc { rows, n: hn, eps };
+        let &(_, kernel) = self.0.iter().find(|(d, _)| *d == desc)?;
+        Some(Step { covers: 2, jobs: alloc::vec![kernel(a.into(), b.into(), w.into(), res.into(), y.into()).into()] })
+    }
+}
