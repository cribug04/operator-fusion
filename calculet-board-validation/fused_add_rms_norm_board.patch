+/// 融合残差与 RMSNorm（照 torch 的 `fused_add_rms_norm`）：`s = a + b`（bf16 里加、舍一次）⇒ 残差写 `res`；
+/// `y = s · rsqrt(mean(s²) + eps) · w`。与「先 `binary!(add)` 再 `rms_norm!`」逐步同序，预期输出逐位一致，且省去一次从 DDR 读回 `s`。
+/// 引擎：[`crate::engines::AddRmsNorm`]（一次认下图里相邻的 `Pointwise(Add)` 与 `Norm(Rms)`）。
+#[macro_export]
+macro_rules! add_rms_norm {
+    ($vis:vis $name:ident: rows = $rows:expr, n = $n:expr, eps = $eps:expr) => {
+        #[npu::kernel(numerics = "ks1")]
+        $vis fn $name(
+            a: npu::Ptr<npu::Ddr, npu::bf16>,
+            b: npu::Ptr<npu::Ddr, npu::bf16>,
+            w: npu::Ptr<npu::Ddr, npu::bf16>,
+            res: npu::Ptr<npu::Ddr, npu::bf16>,
+            y: npu::Ptr<npu::Ddr, npu::bf16>,
+        ) {
+            use npu::prelude::*;
+            const R: usize = $rows;
+            const C: usize = $crate::Line($n).norm_cols(128);
+            const V: usize = $n / C;
+            const SCALE: f32 = 1.0 / $n as f32;
+            let va = $crate::stage!($crate::rd!(a, [R, V, C]), [R, V, C]);
+            let vb = $crate::stage!($crate::rd!(b, [R, V, C]), [R, V, C]);
+            // 残差：与 binary!(add) 同一步（bf16 加、舍一次），写完就进 DDR，后面只读寄存器里的那份
+            va.add(va, vb);
+            va.store($crate::wr!(res, [R, V, C]));
+            $crate::rms_norm!(@scale va, R, V, C, SCALE, $eps);
+            let vw = $crate::stage!($crate::rd!(w, [1, V, C]), [1, V, C]);
+            va.mul(va, bcast(vw, &[0, 1, 2]));
+            va.store($crate::wr!(y, [R, V, C]));
+        }
+    };
+}
+
 /// `y = x · rsqrt(Σx² + eps)`（沿每行，不带权重；gated deltanet 的 q / k）。
 /// 照厂商（libccu `by_head<L2>`，docc callegacy tc/fused/rms_norm.rs）：torch 的写法是 `x / max(‖x‖₂, eps)`，‖x‖ 很小时两者不同。
 #[macro_export]
