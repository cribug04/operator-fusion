+#!/usr/bin/env bash
+set -euo pipefail
+dest=${1:?usage: bash examples/fused_norm/pack.sh NEW_OUTPUT_DIR}
+mkdir -- "$dest"
+dest=$(realpath "$dest")
+cd "$(dirname "$0")/../.."
+target=dopamine-unknown-none-cvx
+build_root=$(realpath -m "${CARGO_TARGET_DIR:-$PWD/target}/fused_norm_board")
+for variant in fused split; do
+    stage="$dest/$variant"
+    mkdir "$stage"
+    features=step
+    if [[ $variant == split ]]; then
+        features=split
+    fi
+    export CARGO_TARGET_DIR="$build_root/$variant"
+    cargo build -p fused_norm --lib --features "$features" --target "$target"
+    cp "$CARGO_TARGET_DIR/$target/npu/fused_norm.cvx" "$stage/step.cvx"
+    cp "$CARGO_TARGET_DIR/$target/npu/fused_norm.cvxo" "$stage/step.cvxo"
+    # docc 0.4.1 checks for this file even with --no-params.
+    touch "$stage/param_blk0.bin"
+    docc calbin from-calvx "$stage" --no-params --network "$variant" -o "$stage/cal"
+    dort calbin parse -f "$stage/cal" > "$stage/layout.txt"
+done
+python3 examples/fused_norm/verify.py generate "$dest"
