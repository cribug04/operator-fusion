+//! 引擎表：融合引擎排在单算子引擎前面，`FirstFit` 就会先让它试。
+
+use calblas::caldnn::{Engine, NormDesc, PwDesc};
+use calblas::engines::{AddRmsNorm, Binary, FusedNormDesc, RmsNorm};
+use npu::{bf16, Ddr, Launch, Ptr};
+
+use crate::kernels;
+use crate::model::{EPS, HIDDEN, ROWS};
+
+type Bf = Ptr<Ddr, bf16>;
+type FusedKernel = fn(Bf, Bf, Bf, Bf, Bf) -> Launch<(Bf, Bf, Bf, Bf, Bf)>;
+type Kernel3 = fn(Bf, Bf, Bf) -> Launch<(Bf, Bf, Bf)>;
+
+/// 融合引擎认的形状表。
+pub const FUSED_TABLE: &[(FusedNormDesc, FusedKernel)] =
+    &[(FusedNormDesc { rows: ROWS, n: HIDDEN, eps: EPS }, kernels::fused_add_rms_norm)];
+
+/// 对照组：单算子的两个引擎。
+pub const ADD_TABLE: &[(PwDesc, Kernel3)] = &[(kernels::residual_add::DESC, kernels::residual_add)];
+pub const NORM_TABLE: &[(NormDesc, Kernel3)] = &[(kernels::hidden_rms_norm::DESC, kernels::hidden_rms_norm)];
+
+pub static FUSED_ENGINE: AddRmsNorm<'static> = AddRmsNorm(FUSED_TABLE);
+pub static ADD_ENGINE: Binary<'static> = Binary(ADD_TABLE);
+pub static NORM_ENGINE: RmsNorm<'static> = RmsNorm(NORM_TABLE);
+
+/// 融合：一条作业认下两个运算。
+pub const FUSED: &[&dyn Engine] = &[&FUSED_ENGINE, &ADD_ENGINE, &NORM_ENGINE];
+/// 对照：不做融合，退回两个单算子引擎。
+pub const SPLIT: &[&dyn Engine] = &[&ADD_ENGINE, &NORM_ENGINE];
