@@ -0,0 +1,60 @@
+//! `cargo run -p fused_norm`：同一张图用两种编排各跑一遍——融合（1 个作业）与两步（2 个作业），
+//! 打印作业、工作区与 DDR 搬运量；最后给外部张量一组示意地址演示 `bind`（没有发射）。
+
+use calblas::caldnn::{Arg, FirstFit, Plan, Uid, VariantPack};
+use fused_norm::{engines, model};
+
+fn fmt(a: &Arg) -> String {
+    match a {
+        Arg::Ptr(u) => format!("%{u}"),
+        other => format!("{other:?}"),
+    }
+}
+
+fn main() {
+    let (g, io) = model::graph();
+    let elems = u64::from(model::ROWS) * u64::from(model::HIDDEN);
+    let bytes = elems * 2; // bf16
+    let wbytes = u64::from(model::HIDDEN) * 2;
+
+    println!("图：{} 个张量、{} 个运算（[{} × {}] bf16，每张矩阵 {} KiB）", g.tensors().len(), g.ops().len(), model::ROWS, model::HIDDEN, bytes / 1024);
+
+    for (label, list) in [("融合", engines::FUSED), ("两步", engines::SPLIT)] {
+        let plan = Plan::new(&g, list, &FirstFit::default()).unwrap_or_else(|e| {
+            eprintln!("{label}：{e}");
+            std::process::exit(1)
+        });
+        let [ddr, sram] = plan.workspace();
+        println!("\n{label}：{} 个作业，工作区 DDR {ddr} B、SRAM {sram} B", plan.jobs().len());
+        for j in plan.jobs() {
+            println!("  {}({})", j.kernel, j.args.iter().map(fmt).collect::<Vec<_>>().join(", "));
+        }
+    }
+
+    // 一趟的 DDR 往返：融合 = 读 a、b、w + 写 res、y；两步 = 再多读一遍残差中间张量（写的时候两份一样）
+    println!(
+        "\n一趟 DDR 搬运（不含主机读写）：融合 {} B、两步 {} B ⇒ 融合省 {} B（{:.1}%）",
+        (4 * bytes + wbytes),
+        (5 * bytes + wbytes),
+        bytes,
+        100.0 * bytes as f64 / (5 * bytes + wbytes) as f64
+    );
+
+    // 示意地址：外部张量按次序紧排（512 B 对齐）
+    let plan = Plan::new(&g, engines::FUSED, &FirstFit::default()).unwrap();
+    let mut next = 0x1_0000_0000u64;
+    let ptrs: Vec<(Uid, u64)> = (0..g.tensors().len())
+        .filter_map(|i| u32::try_from(i).ok().map(Uid))
+        .filter(|&u| !g[u].virt)
+        .map(|u| {
+            let at = next;
+            next = (at + g[u].elem.bytes(g[u].numel().into())).next_multiple_of(512);
+            (u, at)
+        })
+        .collect();
+    let jobs = plan.bind(&VariantPack { ptrs: &ptrs, workspace: next, sram: 0x0800_0000 }).unwrap_or_else(|e| {
+        eprintln!("没给地址：{e:?}");
+        std::process::exit(1)
+    });
+    println!("bind：{} 个作业的指针都换成了地址（a %{}、b %{}、w %{}、residual %{}、y %{}）", jobs.len(), io.a.0, io.b.0, io.w.0, io.residual.0, io.y.0);
+}
