+
+/// 双线性上采样 ×2（NHWC、无边框，bf16）：输入 x `[H][W][C]` ⇒ 输出 y `[2H][2W][C]`。
+///
+/// 语义 = `torch.nn.functional.interpolate(x, scale_factor=2, mode="bilinear", align_corners=False)`
+/// 的 2× 情形：输出像素 (oy, ox) 的源坐标 `u = (ox + 0.5) / 2 - 0.5`，边缘 clamp 到 `[0, W-1] / [0, H-1]`。
+/// 中间按 f32 计算（每一步 mul/add 各舍一次），最后一次性 RNE 舍回 bf16；权重只有 0.25 / 0.75（编译期常数）。
+/// 约束：`C <= 128`（f32 中间 cache 一行 `C*4 B <= 512 B`），`H, W >= 3`，尺寸均为编译期常量。
+///
+/// 实现要点：**无运行时条件分支**（docc 的 calvx-to-calt 目前不收「for 体里带结果的 if」）——
+/// 第 0 行、中间行（`for iy in 1..H-1`，边界都是常量）、最后一行三段展开，行号 clamp 直接写成常量/线性表达式。
+#[macro_export]
+macro_rules! resize_bilinear2 {
+    ($vis:vis $name:ident: h = $h:expr, w = $w:expr, c = $c:expr) => {
+        #[npu::kernel(numerics = "ks1")]
+        $vis fn $name(x: npu::Ptr<npu::Ddr, npu::bf16>, y: npu::Ptr<npu::Ddr, npu::bf16>) {
+            const H: usize = $h;
+            const W: usize = $w;
+            const C: usize = $c;
+            const _: () = assert!(H >= 3 && W >= 3, "resize_bilinear2：H、W 至少 3（第 0 行/最后一行单独展开）");
+            const _: () = assert!(C > 0 && C <= 128, "resize_bilinear2：C 必须 1..=128（f32 中间 cache 一行 ≤ 512 B）");
+
+            // 第 0 行：输出行 0/1 用输入行 (0, 0, 1)
+            $crate::resize_bilinear2!(@pair x, y, $h, $w, $c, 0, 0, 1);
+            // 中间行：输入行 (iy-1, iy, iy+1)
+            for iy in 1..H - 1 {
+                $crate::resize_bilinear2!(@pair x, y, $h, $w, $c, iy - 1, iy, iy + 1);
+            }
+            // 最后一行：输出行 2H-2/2H-1 用输入行 (H-2, H-1, H-1)
+            $crate::resize_bilinear2!(@pair x, y, $h, $w, $c, $h - 2, $h - 1, $h - 1);
+        }
+    };
+
+    // 处理一个「输入行 iy」对应的两条输出行（2iy、2iy+1），ia/ic 是上下邻行（已按边界 clamp 好的常量/线性表达式）。
+    (@pair $x:ident, $y:ident, $h:expr, $w:expr, $c:expr, $ia:expr, $iy:expr, $ic:expr) => {{
+        use npu::prelude::*;
+        const H: usize = $h;
+        const W: usize = $w;
+        const C: usize = $c;
+        const WO: usize = 2 * W;
+        let gx = $x.bind_strided::<npu::Read, 3>([H, W, C], [W * C, C, 1]);
+        // 输出四个相位（行 2iy+a、列 2j+b）：视图行距 2C，行 r 对应输出像素 2r；起点偏 a*WO*C + b*C
+        let g00 = $y.add((0 * WO + 0) * C * 2).bind_strided::<npu::Write, 2>([H * WO, C], [2 * C, 1]);
+        let g01 = $y.add((0 * WO + 1) * C * 2).bind_strided::<npu::Write, 2>([H * WO, C], [2 * C, 1]);
+        let g10 = $y.add((1 * WO + 0) * C * 2).bind_strided::<npu::Write, 2>([H * WO, C], [2 * C, 1]);
+        let g11 = $y.add((1 * WO + 1) * C * 2).bind_strided::<npu::Write, 2>([H * WO, C], [2 * C, 1]);
+        // 三行输入（bf16 与 f32 各一份）+ 六条行内插值结果 + 两条输出 + 临时
+        let (ab, bb, cb) = (vcache::<bf16, _>([W, C]), vcache::<bf16, _>([W, C]), vcache::<bf16, _>([W, C]));
+        let (af, bf, cf) = (vcache::<f32, _>([W, C]), vcache::<f32, _>([W, C]), vcache::<f32, _>([W, C]));
+        let (he_a, ho_a) = (vcache::<f32, _>([W, C]), vcache::<f32, _>([W, C]));
+        let (he_b, ho_b) = (vcache::<f32, _>([W, C]), vcache::<f32, _>([W, C]));
+        let (he_c, ho_c) = (vcache::<f32, _>([W, C]), vcache::<f32, _>([W, C]));
+        let (oe, oo) = (vcache::<f32, _>([W, C]), vcache::<f32, _>([W, C]));
+        let (ob, t) = (vcache::<bf16, _>([W, C]), vcache::<f32, _>([W, C]));
+        ab.load(gx.sub([$ia, 0, 0], [1, W, C]));
+        bb.load(gx.sub([$iy, 0, 0], [1, W, C]));
+        cb.load(gx.sub([$ic, 0, 0], [1, W, C]));
+        af.cvt(ab, Cvt::default());
+        bf.cvt(bb, Cvt::default());
+        cf.cvt(cb, Cvt::default());
+        $crate::resize_bilinear2!(@h af, he_a, ho_a, t, W);
+        $crate::resize_bilinear2!(@h bf, he_b, ho_b, t, W);
+        $crate::resize_bilinear2!(@h cf, he_c, ho_c, t, W);
+
+        // 输出行 2iy = 0.25*row(iy-1) + 0.75*row(iy)
+        oe.mul(he_a, 0.25f32);
+        t.mul(he_b, 0.75f32);
+        oe.add(oe, t);
+        ob.cvt(oe, Cvt::default());
+        ob.store(g00.sub([$iy * WO, 0], [W, C]));
+        oo.mul(ho_a, 0.25f32);
+        t.mul(ho_b, 0.75f32);
+        oo.add(oo, t);
+        ob.cvt(oo, Cvt::default());
+        ob.store(g01.sub([$iy * WO, 0], [W, C]));
+
+        // 输出行 2iy+1 = 0.75*row(iy) + 0.25*row(iy+1)
+        oe.mul(he_b, 0.75f32);
+        t.mul(he_c, 0.25f32);
+        oe.add(oe, t);
+        ob.cvt(oe, Cvt::default());
+        ob.store(g10.sub([$iy * WO, 0], [W, C]));
+        oo.mul(ho_b, 0.75f32);
+        t.mul(ho_c, 0.25f32);
+        oo.add(oo, t);
+        ob.cvt(oo, Cvt::default());
+        ob.store(g11.sub([$iy * WO, 0], [W, C]));
+    }};
+
+    // 行内双线性：he[x] = 0.75*f[x] + 0.25*f[x-1]（x=0 用 f[0]）；ho[x] = 0.75*f[x] + 0.25*f[x+1]（x=W-1 用 f[W-1]）
+    (@h $f:ident, $he:ident, $ho:ident, $t:ident, $w:expr) => {{
+        $he.mul($f, 0.75f32);
+        $t.rows(0, $w - 1).mul($f.rows(0, $w - 1), 0.25f32);
+        $he.rows(1, $w - 1).add($he.rows(1, $w - 1), $t.rows(0, $w - 1));
+        $he.rows(0, 1).copy($f.rows(0, 1));
+        $ho.mul($f, 0.75f32);
+        $t.rows(0, $w - 1).mul($f.rows(1, $w - 1), 0.25f32);
+        $ho.rows(0, $w - 1).add($ho.rows(0, $w - 1), $t.rows(0, $w - 1));
+        $ho.rows($w - 1, 1).copy($f.rows($w - 1, 1));
+    }};
+}
+
+/// 双线性上采样 ×2（NHWC、无边框，bf16）—— **通道分块版**：输入 `[H][W][C]` ⇒ 输出 `[2H][2W][C]`。
+///
+/// 语义与 `resize_bilinear2!` 完全相同（`align_corners=False`、边缘 clamp、f32 中间计算、最后 RNE 舍 bf16），
+/// 区别只在把 C 切成 `NC = C/CC` 块顺序处理：每块的中间 cache 只占 `W × CC` 个元素，因此 **支持更大的 C**
+/// （原版 f32 中间 cache 一行 `C*4 <= 512 B` ⇒ C ≤ 128；分块版按 CC 算）。
+///
+/// 约束：`CC >= 32 && CC % 32 == 0 && C % CC == 0`（块偏移 `cc*CC*2 B` 是 64 B 整数倍，docc 可证对齐）；
+/// `H, W >= 3`；`W*CC*56 B <= 384 KiB`（12 份 f32 + 4 份 bf16 中间 cache 的容量上限）。
+/// 结构：`for cc in 0..NC`（**常数轮数**，docc/calt 允许与内层运行时循环组合，同 `conv2d!` 的 nb 外层）内嵌
+/// “第 0 行 / `for iy in 1..H-1` / 最后一行”三段，全程无运行时条件分支。
+#[macro_export]
+macro_rules! resize_bilinear2_tiled {
+    ($vis:vis $name:ident: h = $h:expr, w = $w:expr, c = $c:expr, cc = $cc:expr) => {
+        #[npu::kernel(numerics = "ks1")]
+        $vis fn $name(x: npu::Ptr<npu::Ddr, npu::bf16>, y: npu::Ptr<npu::Ddr, npu::bf16>) {
+            const H: usize = $h;
+            const W: usize = $w;
+            const C: usize = $c;
+            const CC: usize = $cc;
+            const NC: usize = C / CC;
+            const _: () = assert!(H >= 3 && W >= 3, "resize_bilinear2_tiled：H、W 至少 3");
+            const _: () = assert!(CC >= 32 && CC % 32 == 0 && C % CC == 0, "resize_bilinear2_tiled：CC 是 >=32 的 32 倍数且整除 C");
+            const _: () = assert!(W * CC * 56 <= 384 * 1024, "resize_bilinear2_tiled：W*CC 太大，中间 cache 放不进 VB");
+            for cci in 0..NC {
+                let xoff = cci * CC;
+                $crate::resize_bilinear2_tiled!(@pair x, y, $h, $w, $c, $cc, xoff, 0, 0, 1);
+                for iy in 1..H - 1 {
+                    $crate::resize_bilinear2_tiled!(@pair x, y, $h, $w, $c, $cc, xoff, iy - 1, iy, iy + 1);
+                }
+                $crate::resize_bilinear2_tiled!(@pair x, y, $h, $w, $c, $cc, xoff, $h - 2, $h - 1, $h - 1);
+            }
+        }
+    };
+
+    // 处理输入行 iy 对应的两条输出行 2iy / 2iy+1；ia/ic 是上/下邻行（边界处已 clamp 成常量/线性表达式）。
+    (@pair $x:ident, $y:ident, $h:expr, $w:expr, $c:expr, $cc:expr, $xoff:expr, $ia:expr, $iy:expr, $ic:expr) => {{
+        use npu::prelude::*;
+        const H: usize = $h;
+        const W: usize = $w;
+        const C: usize = $c;
+        const CC: usize = $cc;
+        const WO: usize = 2 * W;
+        let xoff: usize = $xoff;
+        // 输入按“像素行距 C、通道块偏移 xoff”绑定；输出四个相位按“像素行距 2*C、通道块偏移 xoff”绑定
+        let gx = $x.add(xoff * 2).bind_strided::<npu::Read, 3>([H, W, CC], [W * C, C, 1]);
+        let g00 = $y.add(((0 * WO + 0) * C + xoff) * 2).bind_strided::<npu::Write, 2>([H * WO, CC], [2 * C, 1]);
+        let g01 = $y.add(((0 * WO + 1) * C + xoff) * 2).bind_strided::<npu::Write, 2>([H * WO, CC], [2 * C, 1]);
+        let g10 = $y.add(((1 * WO + 0) * C + xoff) * 2).bind_strided::<npu::Write, 2>([H * WO, CC], [2 * C, 1]);
+        let g11 = $y.add(((1 * WO + 1) * C + xoff) * 2).bind_strided::<npu::Write, 2>([H * WO, CC], [2 * C, 1]);
+        let (ab, bb, cb) = (vcache::<bf16, _>([W, CC]), vcache::<bf16, _>([W, CC]), vcache::<bf16, _>([W, CC]));
+        let (af, bf, cf) = (vcache::<f32, _>([W, CC]), vcache::<f32, _>([W, CC]), vcache::<f32, _>([W, CC]));
+        let (he_a, ho_a) = (vcache::<f32, _>([W, CC]), vcache::<f32, _>([W, CC]));
+        let (he_b, ho_b) = (vcache::<f32, _>([W, CC]), vcache::<f32, _>([W, CC]));
+        let (he_c, ho_c) = (vcache::<f32, _>([W, CC]), vcache::<f32, _>([W, CC]));
+        let (oe, oo) = (vcache::<f32, _>([W, CC]), vcache::<f32, _>([W, CC]));
+        let (ob, t) = (vcache::<bf16, _>([W, CC]), vcache::<f32, _>([W, CC]));
+        ab.load(gx.sub([$ia, 0, 0], [1, W, CC]));
+        bb.load(gx.sub([$iy, 0, 0], [1, W, CC]));
+        cb.load(gx.sub([$ic, 0, 0], [1, W, CC]));
+        af.cvt(ab, Cvt::default());
+        bf.cvt(bb, Cvt::default());
+        cf.cvt(cb, Cvt::default());
+        $crate::resize_bilinear2_tiled!(@h af, he_a, ho_a, t, W);
+        $crate::resize_bilinear2_tiled!(@h bf, he_b, ho_b, t, W);
+        $crate::resize_bilinear2_tiled!(@h cf, he_c, ho_c, t, W);
+        oe.mul(he_a, 0.25f32);
+        t.mul(he_b, 0.75f32);
+        oe.add(oe, t);
+        ob.cvt(oe, Cvt::default());
+        ob.store(g00.sub([$iy * WO, 0], [W, CC]));
+        oo.mul(ho_a, 0.25f32);
+        t.mul(ho_b, 0.75f32);
+        oo.add(oo, t);
+        ob.cvt(oo, Cvt::default());
+        ob.store(g01.sub([$iy * WO, 0], [W, CC]));
+        oe.mul(he_b, 0.75f32);
+        t.mul(he_c, 0.25f32);
+        oe.add(oe, t);
+        ob.cvt(oe, Cvt::default());
+        ob.store(g10.sub([$iy * WO, 0], [W, CC]));
+        oo.mul(ho_b, 0.75f32);
+        t.mul(ho_c, 0.25f32);
+        oo.add(oo, t);
+        ob.cvt(oo, Cvt::default());
+        ob.store(g11.sub([$iy * WO, 0], [W, CC]));
+    }};
+
+    // 行内双线性（与 resize_bilinear2! 完全一致）：he[x]=0.75f[x]+0.25f[x-1]，ho[x]=0.75f[x]+0.25f[x+1]，边缘复制。
+    (@h $f:ident, $he:ident, $ho:ident, $t:ident, $w:expr) => {{
+        $he.mul($f, 0.75f32);
+        $t.rows(0, $w - 1).mul($f.rows(0, $w - 1), 0.25f32);
+        $he.rows(1, $w - 1).add($he.rows(1, $w - 1), $t.rows(0, $w - 1));
+        $he.rows(0, 1).copy($f.rows(0, 1));
+        $ho.mul($f, 0.75f32);
+        $t.rows(0, $w - 1).mul($f.rows(1, $w - 1), 0.25f32);
+        $ho.rows(0, $w - 1).add($ho.rows(0, $w - 1), $t.rows(0, $w - 1));
+        $ho.rows($w - 1, 1).copy($f.rows($w - 1, 1));
+    }};
+}
+
+/// **实验性** 3×3 / stride=2 卷积的 FAST 版（NHWC、四周 2 像素边框、bf16；`y = silu(conv(x)+b)`）。
+///
+/// 背景：`conv2d!` 的 FAST 路只覆盖 `S == 1`（`vision.rs:122`），stride-2 卷积（YOLO/UNet 的下采样层）只能走慢路。
+/// 本宏的做法：对每个输出行 `oy` 把 3 个输入行（padded 行 `oy*2+ky+1`）各自拆成 **偶/奇像素两份 VB cache**
+/// （两份都从 DDR 按像素行距 `2*CI` 直接绑视图加载），于是 tap `(ky, kx)` 需要的 lhs 永远是某一份 cache 里
+/// **连续 16 行**：`kx=0 → even[ky] 行 mb*16`；`kx=1 → odd[ky] 行 mb*16`；`kx=2 → even[ky] 行 mb*16+1`。
+/// 这样 stride-2 也能享受“输入行只从 DDR 读一次、9 个 tap 从 VB 取 lhs”快路。
+///
+/// 约束/简化（探针版）：3×3、s=2、`W % 16 == 0`、`CI/CO % 16 == 0`、输入 `[H*2+4][W*2+4][CI]` 紧排（无通道窗口）、
+/// 权重 `[9][CI][CO]` bf16（BN 已折入）、bias f32 `[CO]`、`act = silu | none`、`cores = 2`（按输出行分）。
+#[macro_export]
+macro_rules! conv2d_s2_fast {
+    ($vis:vis $name:ident: h = $h:expr, w = $w:expr, cin = $ci:expr, cout = $co:expr, act = $act:ident) => {
+        #[npu::kernel(numerics = "ks1", cores = 2)]
+        $vis fn $name(
+            x: npu::Ptr<npu::Ddr, npu::bf16>,
+            wt: npu::Ptr<npu::Ddr, npu::bf16>,
+            bias: npu::Ptr<npu::Ddr, f32>,
+            y: npu::Ptr<npu::Ddr, npu::bf16>,
+        ) {
+            use npu::prelude::*;
+            const H: usize = $h;
+            const W: usize = $w;
+            const CI: usize = $ci;
+            const CO: usize = $co;
+            const B: usize = $crate::kernels::BORDER; // 2
+            const WI: usize = W * 2 + 2 * B;          // 输入 padded 宽（像素）
+            const WO: usize = W + 2 * B;              // 输出 padded 宽（像素）
+            const HI: usize = H * 2 + 2 * B;          // 输入 padded 行数
+            const EW: usize = W + 1;                  // 偶/奇 cache 需要的像素列数（0..=W）
+            const _: () = assert!(B == 2 && W % 16 == 0, "conv2d_s2_fast：B=2、W 是 16 的倍数");
+            const _: () = assert!(CI % 16 == 0 && CO % 16 == 0, "conv2d_s2_fast：CI/CO 是 16 的倍数");
+            const NC: usize = $crate::kernels::Cols(CI, CO).nc();
+            const NBLK: usize = CO / NC;
+
+            // 输入紧排 [HI][WO][CI]：偶像素（padded x = B, B+2, …）/ 奇像素（padded x = B+1, B+3, …）
+            let g_even = x.add(B * CI * 2).bind_strided::<npu::Read, 3>([HI, EW, CI], [WI * CI, 2 * CI, 1]);
+            let g_odd = x.add((B + 1) * CI * 2).bind_strided::<npu::Read, 3>([HI, EW, CI], [WI * CI, 2 * CI, 1]);
+            // 输出 [H+4][W+4][CO]（从内部左上角起）
+            let gy = y.add(((B * WO + B) * CO) * 2).bind_strided::<npu::Write, 4>([H, W / 16, 16, CO], [WO * CO, 16 * CO, CO, 1]);
+
+            let (ev0, od0) = (vcache::<bf16, _>([EW, CI]), vcache::<bf16, _>([EW, CI]));
+            let (ev1, od1) = (vcache::<bf16, _>([EW, CI]), vcache::<bf16, _>([EW, CI]));
+            let (ev2, od2) = (vcache::<bf16, _>([EW, CI]), vcache::<bf16, _>([EW, CI]));
+            let gw = $crate::rd!(wt, [9 * CI, CO]);
+            // 每个 nb 的 bias 一行（[NBLK][NC] 的一行）
+            let (lhs, rhs) = (mcache::<bf16, _>([16, CI]), mcache::<bf16, _>([CI, NC]));
+            let (acc, vo) = (mcache::<f32, _>([16, NC]), vcache::<f32, _>([16, NC]));
+            let (vb, yh, tmp) = (vcache::<f32, _>([1, NC]), vcache::<bf16, _>([16, NC]), vcache::<bf16, _>([16, NC]));
+
+            let (h0, hn) = $crate::halves!(H);
+            for i in 0..hn {
+                let oy = h0 + i;
+                // padded 输入行 = oy*2 + ky + 1（padding = 1）
+                ev0.load(g_even.sub([oy * 2 + 1, 0, 0], [1, EW, CI]));
+                od0.load(g_odd.sub([oy * 2 + 1, 0, 0], [1, EW, CI]));
+                ev1.load(g_even.sub([oy * 2 + 2, 0, 0], [1, EW, CI]));
+                od1.load(g_odd.sub([oy * 2 + 2, 0, 0], [1, EW, CI]));
+                ev2.load(g_even.sub([oy * 2 + 3, 0, 0], [1, EW, CI]));
+                od2.load(g_odd.sub([oy * 2 + 3, 0, 0], [1, EW, CI]));
+                for nb in 0..NBLK {
+                    let gb = $crate::rd!(bias, [CO / NC, NC]);
+                    vb.load(gb.sub([nb, 0], [1, NC]));
+                    for mb in 0..W / 16 {
+                        acc.fill(0.0f32);
+                        // tap (0,0)：even[0] 行 mb*16
+                        lhs.load_v(ev0.rows(mb * 16, 16));
+                        rhs.load(gw.sub([0 * CI, nb * NC], [CI, NC]));
+                        acc.mma(lhs, rhs);
+                        // tap (0,1)：odd[0]
+                        lhs.load_v(od0.rows(mb * 16, 16));
+                        rhs.load(gw.sub([1 * CI, nb * NC], [CI, NC]));
+                        acc.mma(lhs, rhs);
+                        // tap (0,2)：even[0] 行 mb*16+1
+                        lhs.load_v(ev0.rows(mb * 16 + 1, 16));
+                        rhs.load(gw.sub([2 * CI, nb * NC], [CI, NC]));
+                        acc.mma(lhs, rhs);
+                        // tap (1,0)：even[1]
+                        lhs.load_v(ev1.rows(mb * 16, 16));
+                        rhs.load(gw.sub([3 * CI, nb * NC], [CI, NC]));
+                        acc.mma(lhs, rhs);
+                        // tap (1,1)：odd[1]
+                        lhs.load_v(od1.rows(mb * 16, 16));
+                        rhs.load(gw.sub([4 * CI, nb * NC], [CI, NC]));
+                        acc.mma(lhs, rhs);
+                        // tap (1,2)：even[1] 行 mb*16+1
+                        lhs.load_v(ev1.rows(mb * 16 + 1, 16));
+                        rhs.load(gw.sub([5 * CI, nb * NC], [CI, NC]));
+                        acc.mma(lhs, rhs);
+                        // tap (2,0)：even[2]
+                        lhs.load_v(ev2.rows(mb * 16, 16));
+                        rhs.load(gw.sub([6 * CI, nb * NC], [CI, NC]));
+                        acc.mma(lhs, rhs);
+                        // tap (2,1)：odd[2]
+                        lhs.load_v(od2.rows(mb * 16, 16));
+                        rhs.load(gw.sub([7 * CI, nb * NC], [CI, NC]));
+                        acc.mma(lhs, rhs);
+                        // tap (2,2)：even[2] 行 mb*16+1
+                        lhs.load_v(ev2.rows(mb * 16 + 1, 16));
+                        rhs.load(gw.sub([8 * CI, nb * NC], [CI, NC]));
+                        acc.mma(lhs, rhs);
+                        // 尾处理：+ bias(f32) ⇒ bf16 ⇒ silu ⇒ 写回
+                        vo.from_m(acc);
+                        vo.add(vo, bcast(vb, &[0, 1]));
+                        yh.cvt(vo, Cvt::default());
+                        $crate::conv2d_s2_fast!(@act $act, yh, tmp);
+                        yh.store(gy.sub([oy, mb, 0, nb * NC], [1, 1, 16, NC]));
+                    }
+                }
+            }
+        }
+    };
+    (@act silu, $yh:ident, $tmp:ident) => { $crate::logistic!(silu, $yh, $yh, $tmp) };
+    (@act none, $yh:ident, $tmp:ident) => {};
+}
