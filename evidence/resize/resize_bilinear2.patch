+//! resize 探针 example：一个 CalVX 程序只跑 `resize_bilinear2`，输入/输出由主机按 decls 写入/读回。
+#![no_std]
+
+pub mod kernels;
+
+#[cfg(feature = "step")]
+mod step;
diff --git a/examples/resize_probe/src/step.rs b/examples/resize_probe/src/step.rs
new file mode 100755
index 0000000..dfee889
--- /dev/null
+++ b/examples/resize_probe/src/step.rs
@@ -0,0 +1,12 @@
+//! 整个程序：静态存储 + 入口（`cargo build --features step --target dopamine-unknown-none-cvx` 出一份 `.cvx`）。
+use crate::kernels::*;
+
+npu::decls! {
+    in_x: input, bytes = 32768, double_buffer;      // 32*32*16*2
+    out_y: output, bytes = 131072, double_buffer;   // 64*64*16*2
+}
+
+#[npu::program(chiplets = 1, cores = 1)]
+pub fn step() {
+    resize_bilinear2(in_x().cast(), out_y().cast());
+}
